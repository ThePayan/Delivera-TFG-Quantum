# Copia este fichero a .env (en esta misma carpeta) y rellena los tokens.
# .env esta ignorado por Git; este .env.example no lleva ningun secreto.

# Fixstars Amplify AE
AMPLIFY_TOKEN=

# Toshiba SQBM+ (opcional). Via Fixstars Amplify basta el token; la URL solo
# hace falta en la version de AWS Marketplace.
SQBM_TOKEN=
SQBM_URL=

# Hitachi Annealing Cloud Web (opcional)
HITACHI_TOKEN=
